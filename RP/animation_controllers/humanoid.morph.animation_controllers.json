{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.morph.humanoid.look_at_target": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [ "humanoid_look_at_target_default" ],
          "transitions": [
            { "gliding": "query.is_gliding" },
            { "swimming": "query.is_swimming || query.is_crawling" }
          ]
        },
        "gliding": {
          "animations": [ "humanoid_look_at_target_gliding" ],
          "transitions": [
            { "swimming": "query.is_swimming || query.is_crawling" },
            { "default": "!query.is_gliding" }
          ]
        },
        "swimming": {
          "animations": [ "humanoid_look_at_target_swimming" ],
          "transitions": [
            { "gliding": "query.is_gliding" },
            { "default": "!query.is_swimming && !query.is_crawling" }
          ]
        }
      }
    },
    "controller.animation.morph.humanoid.melee_spear": {
      "initial_state": "hold",
      "states": {
        "hold": {
          "animations": [ "humanoid_melee_spear_hold" ],
          "transitions": [
            { "use": "variable.item_use_normalized > 0.0" },
            { "attack": "variable.attack_time > 0.0" }
          ]
        },
        "use": {
          "animations": [ "humanoid_melee_spear_use" ],
          "transitions": [
            { "hold": "variable.item_use_normalized == 0.0" }
          ],
          "blend_transition": 1.0
        },
        "attack": {
          "animations": [ "humanoid_melee_spear_attack" ],
          "transitions": [
            { "hold": "variable.attack_time == 0.0" },
            { "use": "variable.item_use_normalized > 0.0" }
          ]
        }
      }
    }
  }
}
