{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.morph.dolphin.particles": {
            "initial_state": "default",
            "states": {
                "default": {
                    "transitions": [
                        {
                            "particles": "query.property('dark7mc:entity') == 38 && !query.is_sleeping"
                        }
                    ]
                },
                "particles": {
                    "particle_effects": [
                        {
                            "effect": "dolphin_move_particle",
                            "locator": "dolphin_move_particle_emitter"
                        }
                    ],
                    "transitions": [
                        {
                            "default": "query.property('dark7mc:entity') != 38 || query.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}