{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.morph.night_fury.locomotion": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [ "night_fury_idle" ],
          "blend_transition": 0.2,
          "transitions": [
            { "diving": "!query.is_on_ground && !query.is_sleeping && query.ground_speed >= 12.0 && query.vertical_speed <= -0.1" },
            { "gliding": "!query.is_on_ground && !query.is_sleeping && query.ground_speed >= 12.0 && query.vertical_speed > -0.1 && query.vertical_speed <= 0.1" },
            { "flying": "!query.is_on_ground && !query.is_sleeping && (query.vertical_speed > 0.1 || (query.ground_speed >= 0.5 && query.ground_speed < 12.0))" },
            { "hovering": "!query.is_on_ground && !query.is_sleeping && query.ground_speed < 0.5 && math.abs(query.vertical_speed) <= 0.01" },
            { "running": "query.is_on_ground && query.is_sprinting && query.modified_move_speed > 0.03 && !query.is_sleeping" },
            { "walking": "query.is_on_ground && !query.is_sprinting && query.modified_move_speed > 0.03 && !query.is_sleeping" },
            { "sitting": "query.is_sneaking && query.ground_speed < 0.5 && !query.is_sleeping" },
            { "sleeping": "query.is_sleeping" }
          ]
        },
        "walking": {
          "animations": [ "night_fury_walk" ],
          "blend_transition": 0.2,
          "transitions": [
            { "diving": "!query.is_on_ground && !query.is_sleeping && query.ground_speed >= 12.0 && query.vertical_speed <= -0.1" },
            { "gliding": "!query.is_on_ground && !query.is_sleeping && query.ground_speed >= 12.0 && query.vertical_speed > -0.1 && query.vertical_speed <= 0.1" },
            { "flying": "!query.is_on_ground && !query.is_sleeping && (query.vertical_speed > 0.1 || (query.ground_speed >= 0.5 && query.ground_speed < 12.0))" },
            { "hovering": "!query.is_on_ground && !query.is_sleeping && query.ground_speed < 0.5 && math.abs(query.vertical_speed) <= 0.01" },
            { "running": "query.is_on_ground && query.is_sprinting && query.modified_move_speed > 0.03 && !query.is_sleeping" },
            { "idle": "query.is_on_ground && query.modified_move_speed <= 0.03 && !query.is_sleeping" },
            { "sitting": "query.is_sneaking && query.ground_speed < 0.5 && !query.is_sleeping" },
            { "sleeping": "query.is_sleeping" }
          ]
        },
        "running": {
          "animations": [ "night_fury_run" ],
          "blend_transition": 0.2,
          "transitions": [
            { "diving": "!query.is_on_ground && !query.is_sleeping && query.ground_speed >= 12.0 && query.vertical_speed <= -0.1" },
            { "gliding": "!query.is_on_ground && !query.is_sleeping && query.ground_speed >= 12.0 && query.vertical_speed > -0.1 && query.vertical_speed <= 0.1" },
            { "flying": "!query.is_on_ground && !query.is_sleeping && (query.vertical_speed > 0.1 || (query.ground_speed >= 0.5 && query.ground_speed < 12.0))" },
            { "hovering": "!query.is_on_ground && !query.is_sleeping && query.ground_speed < 0.5 && math.abs(query.vertical_speed) <= 0.01" },
            { "walking": "query.is_on_ground && !query.is_sprinting && query.modified_move_speed > 0.03 && !query.is_sleeping" },
            { "idle": "query.is_on_ground && query.modified_move_speed <= 0.03 && !query.is_sleeping" },
            { "sitting": "query.is_sneaking && query.ground_speed < 0.5 && !query.is_sleeping" },
            { "sleeping": "query.is_sleeping" }
          ]
        },
        "flying": {
          "animations": [ "night_fury_flap" ],
          "blend_transition": 0.2,
          "transitions": [
            { "diving": "!query.is_on_ground && !query.is_sleeping && query.ground_speed >= 12.0 && query.vertical_speed <= -0.1" },
            { "gliding": "!query.is_on_ground && !query.is_sleeping && query.ground_speed >= 12.0 && query.vertical_speed > -0.1 && query.vertical_speed <= 0.1" },
            { "hovering": "!query.is_on_ground && !query.is_sleeping && query.ground_speed < 0.5 && math.abs(query.vertical_speed) <= 0.01" },
            { "running": "query.is_on_ground && query.is_sprinting && query.modified_move_speed > 0.03 && !query.is_sleeping" },
            { "walking": "query.is_on_ground && query.modified_move_speed > 0.03 && !query.is_sleeping" },
            { "idle": "query.is_on_ground && query.modified_move_speed <= 0.03 && !query.is_sleeping" },
            { "sitting": "query.is_sneaking && query.ground_speed < 0.5 && !query.is_sleeping" },
            { "sleeping": "query.is_sleeping" }
          ]
        },
        "hovering": {
          "animations": [ "night_fury_hover" ],
          "blend_transition": 0.2,
          "transitions": [
            { "diving": "!query.is_on_ground && !query.is_sleeping && query.ground_speed >= 12.0 && query.vertical_speed <= -0.1" },
            { "gliding": "!query.is_on_ground && !query.is_sleeping && query.ground_speed >= 12.0 && query.vertical_speed > -0.1 && query.vertical_speed <= 0.1" },
            { "flying": "!query.is_on_ground && !query.is_sleeping && (query.vertical_speed > 0.1 || (query.ground_speed >= 0.5 && query.ground_speed < 12.0))" },
            { "running": "query.is_on_ground && query.is_sprinting && query.modified_move_speed > 0.03 && !query.is_sleeping" },
            { "walking": "query.is_on_ground && query.modified_move_speed > 0.03 && !query.is_sleeping" },
            { "idle": "query.is_on_ground && query.modified_move_speed <= 0.03 && !query.is_sleeping" },
            { "sitting": "query.is_sneaking && query.ground_speed < 0.5 && !query.is_sleeping" },
            { "sleeping": "query.is_sleeping" }
          ]
        },
        "gliding": {
          "animations": [ "night_fury_glide" ],
          "blend_transition": 0.2,
          "transitions": [
            { "diving": "!query.is_on_ground && !query.is_sleeping && query.ground_speed >= 12.0 && query.vertical_speed <= -0.1" },
            { "flying": "!query.is_on_ground && !query.is_sleeping && (query.vertical_speed > 0.1 || query.ground_speed < 12.0)" },
            { "hovering": "!query.is_on_ground && !query.is_sleeping && query.ground_speed < 0.5 && math.abs(query.vertical_speed) <= 0.01" },
            { "running": "query.is_on_ground && query.is_sprinting && query.modified_move_speed > 0.03 && !query.is_sleeping" },
            { "walking": "query.is_on_ground && query.modified_move_speed > 0.03 && !query.is_sleeping" },
            { "idle": "query.is_on_ground && query.modified_move_speed <= 0.03 && !query.is_sleeping" },
            { "sitting": "query.is_sneaking && query.ground_speed < 0.5 && !query.is_sleeping" },
            { "sleeping": "query.is_sleeping" }
          ]
        },
        "diving": {
          "animations": [ "night_fury_dive" ],
          "blend_transition": 0.2,
          "transitions": [
            { "gliding": "!query.is_on_ground && !query.is_sleeping && query.ground_speed >= 12.0 && query.vertical_speed > -0.1 && query.vertical_speed <= 0.1" },
            { "flying": "!query.is_on_ground && !query.is_sleeping && (query.vertical_speed > 0.1 || query.ground_speed < 12.0)" },
            { "hovering": "!query.is_on_ground && !query.is_sleeping && query.ground_speed < 0.5 && math.abs(query.vertical_speed) <= 0.01" },
            { "running": "query.is_on_ground && query.is_sprinting && query.modified_move_speed > 0.03 && !query.is_sleeping" },
            { "walking": "query.is_on_ground && query.modified_move_speed > 0.03 && !query.is_sleeping" },
            { "idle": "query.is_on_ground && query.modified_move_speed <= 0.03 && !query.is_sleeping" },
            { "sitting": "query.is_sneaking && query.ground_speed < 0.5 && !query.is_sleeping" },
            { "sleeping": "query.is_sleeping" }
          ]
        },
        "sitting": {
          "animations": [ "night_fury_sit" ],
          "blend_transition": 0.2,
          "transitions": [
            { "diving": "!query.is_on_ground && !query.is_sleeping && query.ground_speed >= 12.0 && query.vertical_speed <= -0.1" },
            { "gliding": "!query.is_on_ground && !query.is_sleeping && query.ground_speed >= 12.0 && query.vertical_speed > -0.1 && query.vertical_speed <= 0.1" },
            { "flying": "!query.is_on_ground && !query.is_sleeping && (query.vertical_speed > 0.1 || (query.ground_speed >= 0.5 && query.ground_speed < 12.0))" },
            { "hovering": "!query.is_on_ground && !query.is_sleeping && query.ground_speed < 0.5 && math.abs(query.vertical_speed) <= 0.01" },
            { "running": "query.is_on_ground && query.is_sprinting && query.modified_move_speed > 0.03 && !query.is_sleeping" },
            { "walking": "query.is_on_ground && !query.is_sprinting && query.modified_move_speed > 0.03 && !query.is_sleeping" },
            { "idle": "(!query.is_sneaking || query.ground_speed >= 0.5) && !query.is_sleeping" },
            { "sleeping": "query.is_sleeping" }
          ]
        },
        "sleeping": {
          "animations": [ "night_fury_sleep" ],
          "blend_transition": 0.3,
          "transitions": [
            { "idle": "!query.is_sleeping" }
          ]
        }
      }
    },
    "controller.animation.morph.night_fury.bite": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            { "biting": "variable.attack_time > 0.0 && !query.is_sleeping" }
          ]
        },
        "biting": {
          "animations": [ "night_fury_bite_anim" ],
          "transitions": [
            { "default": "query.all_animations_finished" }
          ]
        }
      }
    }
  }
}