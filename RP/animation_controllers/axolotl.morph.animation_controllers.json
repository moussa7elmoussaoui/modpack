{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.morph.axolotl.move": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            {
              "axolotl_idle_float": "query.is_in_water && !query.is_on_ground && !query.is_baby"
            },
            {
              "axolotl_idle_floor": "!query.is_in_water && !query.is_baby"
            },
            {
              "axolotl_idle_floor_water": "query.is_in_water && query.is_on_ground && !query.is_baby"
            },
            {
              "axolotl_baby_idle_float": "query.is_in_water && !query.is_on_ground && query.is_baby"
            },
            {
              "axolotl_baby_idle_floor": "!query.is_in_water && query.is_baby"
            },
            {
              "axolotl_baby_idle_floor_water": "query.is_in_water && query.is_on_ground && query.is_baby"
            }
          ],
          "transitions": [
            {
              "moving": "query.ground_speed > 0 || query.vertical_speed > 0"
            }
          ]
        },
        "moving": {
          "animations": [
            {
              "axolotl_swim": "query.is_in_water && !query.is_on_ground && !query.is_baby"
            },
            {
              "axolotl_walk_floor": "!query.is_in_water && !query.is_baby"
            },
            {
              "axolotl_walk_floor_water": "query.is_in_water && query.is_on_ground && !query.is_baby"
            },
            {
              "axolotl_baby_swim": "query.is_in_water && !query.is_on_ground && query.is_baby"
            },
            {
              "axolotl_baby_walk_floor": "!query.is_in_water && query.is_baby"
            },
            {
              "axolotl_baby_walk_floor_water": "query.is_in_water && query.is_on_ground && query.is_baby"
            }
          ],
          "transitions": [
            {
              "idle": "query.ground_speed <= 0 && query.vertical_speed <= 0"
            }
          ]
        }
      }
    }
  }
}