{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.omnitrix": {
      "initial_state": "closed",
      "states": {
        "closed": {
          "transitions": [
            { "opening": "((!query.is_in_ui && variable.is_either_person) || (query.is_in_ui && !variable.is_paperdoll)) ? query.property('dark7mc:omnitrix_state') == 'opening' : 0.0" },
            { "open": "((!query.is_in_ui && variable.is_either_person) || (query.is_in_ui && !variable.is_paperdoll)) ? query.property('dark7mc:omnitrix_state') == 'open' : 0.0" },
            { "closing": "((!query.is_in_ui && variable.is_either_person) || (query.is_in_ui && !variable.is_paperdoll)) ? query.property('dark7mc:omnitrix_state') == 'closing' : 0.0" }
          ]
        },
        "opening": {
          "animations": [ "omnitrix_open" ],
          "transitions": [
            { "open": "((!query.is_in_ui && variable.is_either_person) || (query.is_in_ui && !variable.is_paperdoll)) ? query.property('dark7mc:omnitrix_state') == 'open' : 0.0" },
            { "closing": "((!query.is_in_ui && variable.is_either_person) || (query.is_in_ui && !variable.is_paperdoll)) ? query.property('dark7mc:omnitrix_state') == 'closing' : 0.0" }
          ]
        },
        "open": {
          "animations": [ "omnitrix_open_idle" ],
          "transitions": [
            { "closing": "((!query.is_in_ui && variable.is_either_person) || (query.is_in_ui && !variable.is_paperdoll)) ? query.property('dark7mc:omnitrix_state') == 'closing' : 0.0" }
          ]
        },
        "closing": {
          "animations": [ "omnitrix_close" ],
          "transitions": [
            { "closed": "((!query.is_in_ui && variable.is_either_person) || (query.is_in_ui && !variable.is_paperdoll)) ? (query.property('dark7mc:omnitrix_state') == 'worn_closed' || query.property('dark7mc:omnitrix_state') == 'unworn') : 0.0" }
          ]
        }
      }
    }
  }
}
