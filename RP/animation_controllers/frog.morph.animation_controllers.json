{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.morph.frog.general": {
			"initial_state": "on_land",
			"states": {
				"on_land": {
					"animations": [
						{ "frog_walk": "math.min(1.0, query.modified_move_speed * 10)" }
					],
					"transitions": [
						{ "idling_water": "query.is_in_water && query.modified_move_speed < 0.15" },
						{ "swimming": "query.is_in_water && query.modified_move_speed > 0.15" },
						{ "jumping": "query.is_powered" }
					]
				},
				"jumping": {
					"animations": [
						{ "frog_jump": "query.is_powered" }
					],
					"transitions": [
						{ "on_land": "!query.is_in_water && !query.is_powered" },
						{ "idling_water": "query.is_in_water && query.modified_move_speed < 0.15" },
						{ "swimming": "query.is_in_water && query.modified_move_speed > 0.15" }
					]

				},
				"idling_water": {
					"animations": [
						"frog_idle_water"
					],
					"transitions": [
						{ "on_land": "!query.is_in_water" },
						{ "swimming": "query.is_in_water && query.modified_move_speed > 0.15" }
					]
				},
				"swimming": {
					"animations": [
						{ "frog_swim": "math.min(1.0, query.modified_move_speed * 10)" }
					],
					"transitions": [
						{ "on_land": "!query.is_in_water" },
						{ "idling_water": "query.is_in_water && query.modified_move_speed < 0.15" }
					]
				}
			}
		},
		"controller.animation.morph.frog.eat_mob": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{ "eating": "variable.attack_time > 0.0" }
					]
				},
				"eating": {
					"animations": [ "frog_tongue" ],
					"transitions": [
						{ "default": "query.all_animations_finished" }
					]
				}
			}
		},
		"controller.animation.morph.frog.croaking": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{ "croaking": "variable.frog_is_croaking" }
					]
				},
				"croaking": {
					"animations": [ "frog_croak" ],
					"transitions": [
						{ "default": "!variable.frog_is_croaking || variable.attack_time > 0.0" }
					]
				}
			}
		}
	}
}