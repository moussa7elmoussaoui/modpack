{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.morph.rabbit.general": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            { "moving": "variable.rabbit_moving" },
            { "idling": "!variable.rabbit_moving && variable.rabbit_should_idle" }
          ]
        },
        "idling": {
          "transitions": [
            { "default": "!variable.rabbit_moving && query.all_animations_finished" },
            { "moving": "variable.rabbit_moving" }
          ],
          "animations": [ "rabbit_idle_head_tilt" ]
        },
        "moving": {
          "transitions": [
            { "default": "!variable.rabbit_moving || (query.all_animations_finished && !query.is_on_ground)" }
          ],
          "animations": [
            { "rabbit_move": "!query.is_baby" },
            { "rabbit_move_baby": "query.is_baby" }
          ],
          "blend_transition": 0.2
        }
      }
    }
  }
}
