{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.morph.zombie.melee_spear": {
      "initial_state": "hold",
      "states": {
        "hold": {
          "animations": [ "zombie_melee_spear_hold" ],
          "transitions": [
            {
              "use": "variable.item_use_normalized > 0.0"
            },
            {
              "attack": "variable.attack_time > 0.0"
            }
          ]
        },
        "use": {
          "animations": [ "zombie_melee_spear_use" ],
          "transitions": [
            {
              "hold": "variable.item_use_normalized == 0.0"
            }
          ],
          "blend_transition": 1.0
        },
        "attack": {
          "animations": [ "zombie_melee_spear_attack" ],
          "transitions": [
            {
              "hold": "variable.attack_time == 0.0"
            },
            {
              "use": "variable.item_use_normalized > 0.0"
            }
          ]
        }
      }
    }
  }
}
