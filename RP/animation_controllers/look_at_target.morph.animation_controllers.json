{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.morph.common.look_at_target": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [ "common_look_at_target_default" ],
          "transitions": [
            { "gliding": "query.is_gliding" },
            { "swimming": "query.is_swimming || query.is_crawling" }
          ]
        },
        "gliding": {
          "animations": [ "common_look_at_target_gliding" ],
          "transitions": [
            { "swimming": "query.is_swimming || query.is_crawling" },
            { "default": "!query.is_gliding" }
          ]
        },
        "swimming": {
          "animations": [ "common_look_at_target_swimming" ],
          "transitions": [
            { "gliding": "query.is_gliding" },
            { "default": "!query.is_swimming && !query.is_crawling" }
          ]
        }
      }
    },
    "controller.animation.morph.common.look_at_target.vertical_gliding": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [ "common_look_at_target_default" ],
          "transitions": [
            { "vertical_gliding": "query.is_gliding" }
          ]
        },
        "vertical_gliding": {
          "animations": [ "common_look_at_target_vertical_gliding" ],
          "transitions": [
            { "default": "!query.is_gliding" }
          ]
        }
      }
    }
  }
}
