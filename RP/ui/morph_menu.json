{
  "namespace": "morph_menu",
  
  "long_form": {
    "type": "panel",
    "size": [ 418, 252 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "title_bar": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ 320, 24 ],
          "offset": [ 0, 0 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "controls": [
            {
              "title_background": {
                "type": "image",
                "size": [ "fill", "100%" ],
                "texture": "textures/ui/glui/dialog_title_background",
                "controls": [
                  {
                    "title_label": {
                      "type": "label",
                      "text": "#title_text",
                      "color": [ 1, 1, 1 ],
                      "size": [ "default", "default" ],
                      "max_size": [ "100% - 14px", "100% - 2px" ],
                      "offset": [ 0, -2 ],
                      "font_type": "MinecraftTen",
                      "bindings": [
                        {
                          "binding_type": "global",
                          "binding_name": "#title_text"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "title_cancel_spacing": {
                "type": "panel",
                "size": [ 2, "!00%" ]
              }
            },
            {
              "cancel_button@morph_menu.themed_button": {
                "$pressed_button_name": "button.menu_exit",
                "$button_content": "morph_menu.close_icon",
                "$default_content_offset": [ 0, -1 ],
                "$hover_content_offset": [ 0, -1 ],
                "size": [ "100%y", "100%" ]
              }
            }
          ]
        }
      },
      {
        "menu_frame": {
          "type": "panel",
          "size": [ 320, 224 ],
          "offset": [ 0, 26 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "controls": [
            {
              "frame_background": {
                "type": "image",
                "size": [ "100%", "100%" ],
                "texture": "textures/ui/glui/dialog_background"
              }
            },
            {
              "menu_content@morph_menu.long_form_panel": {
                "size": [ 306, 210 ],
                "offset": [ 7, 7 ],
                "anchor_from": "top_left",
                "anchor_to": "top_left"
              }
            }
          ]
        }
      },
      {
        "player_frame": {
          "type": "panel",
          "size": [ 96, 96 ],
          "offset": [ 322, 92 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "controls": [
            {
              "frame_background": {
                "type": "image",
                "size": [ "100%", "100%" ],
                "texture": "textures/ui/glui/dialog_background"
              }
            },
            {
              "player_renderer@morph_menu.player_renderer_panel": {
                "size": [ 32, 32 ],
                "anchor_from": "center",
                "anchor_to": "center",
                "offset": [ 0, -14 ]
              }
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#title_text = 'morph.menu.title') or (#title_text = 'morph.menu.player') or (#title_text = 'morph.menu.variant'))",
        "target_property_name": "#visible"
      }
    ]
  },
  
  "player_renderer_panel": {
    "type": "panel",
    "size": [ 32, 32 ],
    "offset": [ 0, -14 ],
    "controls": [
      {
        "player_renderer": {
          "type": "custom",
          "renderer": "live_player_renderer",
          "property_bag": {
            "#look_at_cursor": true
          },
          "animation_reset_name": "screen_animation_reset",
          "anims": [
            "@common.screen_exit_size_animation_push",
            "@common.screen_exit_size_animation_pop",
            "@common.screen_entrance_size_animation_push",
            "@common.screen_entrance_size_animation_pop"
          ],
          "layer": 4,
          "anchor_from": "center",
          "anchor_to": "center"
        }
      }
    ]
  },

  "close_icon": {
    "type": "image",
    "texture": "textures/ui/glui/icons/close",
    "size": [ 16, 16 ],
    "anchor_from": "center",
    "anchor_to": "center"
  },

  "scrollbar_handle": {
    "type": "image",
    "texture": "textures/ui/glui/scroll_handle"
  },

  "scrollbar_track": {
    "type": "image",
    "texture": "textures/ui/glui/scroll_track"
  },

  "avatar_scrollbar@common.scrolling_panel": {
    "$scroll_box_touch_image_control": "morph_menu.scrollbar_handle",
    "$scroll_box_mouse_image_control": "morph_menu.scrollbar_handle",
    "$scroll_track_image_control": "morph_menu.scrollbar_track"
  },

  "button_panel": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "$button_content_size|default": [ "100% - 4px", "100% - 4px" ],
    "$button_content|default": "common.empty_panel",
    "$button_content_offset|default": [ 0, 0 ],
    "$button_border_visible|default": false,
    "controls": [
      {
        "button_image": {
          "type": "image",
          "texture": "$button_texture",
          "size": [ "100%", "100%" ]
        }
      },
      {
        "button_content_panel": {
          "type": "panel",
          "size": "$button_content_size",
          "offset": "$button_content_offset",
          "controls": [
            {
              "button_content@$button_content": {}
            }
          ]
        }
      }
    ]
  },

  "themed_button@common.button": {
    "$button_panel": "morph_menu.button_panel",
    "$default_texture": "textures/ui/glui/buttons/light_button_default",
    "$hover_texture": "textures/ui/glui/buttons/light_button_hover",
    "$pressed_texture": "textures/ui/glui/buttons/light_button_pressed",
    "$default_content_offset": [ 0, 0 ],
    "$hover_content_offset": [ 0, 0 ],
    "$pressed_content_offset": [ 0, 0 ],
    "$default_border_visible": false,
    "$hover_border_visible": false,
    "$pressed_border_visible": false,
    "controls": [
      {
        "default@$button_panel": {
          "$button_texture": "$default_texture",
          "$button_content_offset": "$default_content_offset",
          "$button_border_visible": "$default_border_visible"
        }
      },
      {
        "hover@$button_panel": {
          "$button_texture": "$hover_texture",
          "$button_content_offset": "$hover_content_offset",
          "$button_border_visible": "$hover_border_visible"
        }
      },
      {
        "pressed@$button_panel": {
          "$button_texture": "$hover_texture",
          "$button_content_offset": "$pressed_content_offset",
          "$button_border_visible": "$pressed_border_visible"
        }
      }
    ]
  },

  "long_form_panel": {
    "type": "panel",
    "size": [ 306, 210 ],
    "layer": 1,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "player_scrolling_panel@morph_menu.avatar_scrollbar": {
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "$show_background": false,
          "size": [ "100%", "100%" ],
          "$scrolling_content": "morph_menu.player_scrolling_content",
          "$scroll_size": [ 5, "100% - 4px" ],
          "$scrolling_pane_size": [ "100% - 4px", "100%" ],
          "$scrolling_pane_offset": [ 2, 0 ],
          "$scroll_bar_right_padding_size": [ 0, 0 ],
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text = 'morph.menu.player')",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "scrolling_panel@morph_menu.avatar_scrollbar": {
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "$show_background": false,
          "size": [ "100%", "100%" ],
          "$scrolling_content": "morph_menu.long_form_scrolling_content",
          "$scroll_size": [ 5, "100% - 4px" ],
          "$scrolling_pane_size": [ "100% - 4px", "100%" ],
          "$scrolling_pane_offset": [ 2, 0 ],
          "$scroll_bar_right_padding_size": [ 0, 0 ],
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#title_text = 'morph.menu.title') or (#title_text = 'morph.menu.variant'))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
"long_form_scrolling_content": {
    "type": "stack_panel",
  "size": [ "100%", "100%c" ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",

    "controls": [
      {
        "top_padding": {
          "type": "panel",
          "size": [ "100%", 4 ]
        }
      },
      {
        "wrapping_panel": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [
            {
              "long_form_dynamic_buttons_panel@morph_menu.long_form_dynamic_buttons_panel": {}
            }
          ]
        }
      },
      {
        "bottom_padding": {
          "type": "panel",
          "size": [ "100%", 4 ]
        }
      }
    ]
  },

  "long_form_dynamic_buttons_panel": {
    "type": "grid",
    "size": [ "100%", "100%c" ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",

    "grid_rescaling_type": "horizontal",
    "grid_item_template": "morph_menu.dynamic_button",

    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_length",
        "binding_name_override": "#maximum_grid_items"
      }
    ]
  },

  "player_scrolling_content": {
    "type": "stack_panel",
    "size": [ "100%", "100%c" ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "top_padding": {
          "type": "panel",
          "size": [ "100%", 4 ]
        }
      },
      {
        "wrapping_panel": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [
            {
              "player_dynamic_buttons_panel@morph_menu.player_dynamic_buttons_panel": {}
            }
          ]
        }
      },
      {
        "bottom_padding": {
          "type": "panel",
          "size": [ "100%", 4 ]
        }
      }
    ]
  },

  "player_dynamic_buttons_panel": {
    "type": "grid",
    "size": [ "100%", "100%c" ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "grid_rescaling_type": "horizontal",
    "grid_item_template": "morph_menu.player_dynamic_button",
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_length",
        "binding_name_override": "#maximum_grid_items"
      }
    ]
  },

  "player_dynamic_button": {
    "type": "panel",
    "size": [ 58, 50 ],
    "clips_children": true,
    "controls": [
      {
        "image": {
          "type": "image",
          "layer": 2,
          "size": [ 32, 32 ],
          "offset": [ 0, -5 ],
          "bindings": [
            {
              "binding_name": "#form_button_texture",
              "binding_name_override": "#texture",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_name": "#form_button_texture_file_system",
              "binding_name_override": "#texture_file_system",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      },
      {
        "player_name": {
          "type": "label",
          "size": [ "100% - 6px", 10 ],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [ 0, -2 ],
          "layer": 5,
          "color": [ 1, 1, 1 ],
          "text": "#player_name_text",
          "text_alignment": "center",
          "font_scale_factor": 0.8,
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_name_override": "#player_name_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (#player_name_text = ''))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "form_button@morph_menu.themed_button": {
          "$pressed_button_name": "button.form_button_click",
          "size": [ 58, 50 ],
          "controls": [
            {
              "hover@common.focus_border_white": {}
            },
            {
              "pressed@common.focus_border_white": {}
            }
          ],
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  "dynamic_button": {
    "type": "panel",
    "size": [ 48, 48 ],
    "controls": [
      {
        "panel_name": {
          "type": "panel",
          "size": [ "100%c", "100%c" ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "image",
              "resolve_sibling_scope": true,
              "source_property_name": "(not (#texture = ''))",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "image": {
                "type": "image",
                "layer": 2,
                "size": [ 32, 32 ],
                "offset": [ 0, 0 ],
                "bindings": [
                  {
                    "binding_name": "#form_button_texture",
                    "binding_name_override": "#texture",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_name": "#form_button_texture_file_system",
                    "binding_name_override": "#texture_file_system",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "progress@progress.progress_loading_bars": {
                "size": [ 32, 4 ],
                "offset": [ 0, 0 ],
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "image",
                    "resolve_sibling_scope": true,
                    "source_property_name": "(#texture = 'loading')",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "badge": {
          "type": "label",
          "size": [ 26, 14 ],
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [ -3, -1 ],
          "layer": 5,
          "color": [ 1, 0.8, 0 ],
          "text": "#badge_text",
          "text_alignment": "right",
          "font_scale_factor": 1.2,
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_name_override": "#badge_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (#badge_text = ''))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "form_button@morph_menu.themed_button": {
          "$pressed_button_name": "button.form_button_click",
          "size": [ 48, 48 ],
          "controls": [
            {
              "hover@common.focus_border_white": {}
            },
            {
              "pressed@common.focus_border_white": {}
            }
          ],
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  }
}
