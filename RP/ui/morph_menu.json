{
  "namespace": "morph_menu",
  
  "long_form": {
    "type": "panel",
    "controls": [
      {
        "long_form_content@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [ "100% - 15px", 10 ],
          "$title_max_size": [ "100% - 15px", 10 ],
          "size": [ 320, 224 ],
          "offset": [ -22, 0 ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "morph_menu.long_form_panel",
          "layer": 2,
          "$custom_background": "morph_menu.menu_background"
        }
      },
      {
        "player_renderer_dialog@common_dialogs.main_panel_no_title_no_buttons": {
          "$show_close_button": false,
          "size": [ 96, 96 ],
          "offset": [ 178, -40 ],
          "$child_control": "morph_menu.player_renderer_panel",
          "layer": 1,
          "$custom_background": "morph_menu.player_renderer_background"
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#title_text = 'morph.menu.title') or (#title_text = 'morph.menu.player') or (#title_text = 'morph.menu.variant'))",
        "target_property_name": "#visible"
      }
    ]
  },
  
  "player_renderer_panel": {
    "type": "panel",
    "size": [ 32, 32 ],
    "offset": [ 0, -14 ],
    "controls": [
      {
        "player_renderer": {
          "type": "custom",
          "renderer": "live_player_renderer",
          "property_bag": {
            "#look_at_cursor": true
          },
          "animation_reset_name": "screen_animation_reset",
          "anims": [
            "@common.screen_exit_size_animation_push",
            "@common.screen_exit_size_animation_pop",
            "@common.screen_entrance_size_animation_push",
            "@common.screen_entrance_size_animation_pop"
          ],
          "layer": 4,
          "anchor_from": "center",
          "anchor_to": "center"
        }
      }
    ]
  },

  "long_form_panel": {
    "type": "stack_panel",
    "size": ["100%", "100%"],
    "orientation": "vertical",
    "layer": 1,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "player_scrolling_panel@common.scrolling_panel": {
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "$show_background": false,
          "size": [ "100%", "100%" ],
          "$scrolling_content": "morph_menu.player_scrolling_content",
          "$scroll_size": [ 5, "100% - 4px" ],
          "$scrolling_pane_size": [ "100%", "100%" ],
          "$scrolling_pane_offset": [ 2, 0 ],
          "$scroll_bar_right_padding_size": [ 0, 0 ],
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text = 'morph.menu.player')",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "scrolling_panel@common.scrolling_panel": {
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "$show_background": false,
          "size": [ "100%", "100%" ],
          "$scrolling_content": "morph_menu.long_form_scrolling_content",
          "$scroll_size": [ 5, "100% - 4px" ],
          "$scrolling_pane_size": [ "100% - 4px", "100%" ],
          "$scrolling_pane_offset": [ 2, 0 ],
          "$scroll_bar_right_padding_size": [ 0, 0 ],
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#title_text = 'morph.menu.title') or (#title_text = 'morph.menu.variant'))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
"long_form_scrolling_content": {
    "type": "stack_panel",
    "size": [ "100%", "100%c" ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",

    "controls": [
      {
        "top_padding": {
          "type": "panel",
          "size": [ "100%", 4 ]
        }
      },
      {
        "wrapping_panel": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [
            {
              "long_form_dynamic_buttons_panel@morph_menu.long_form_dynamic_buttons_panel": {}
            }
          ]
        }
      },
      {
        "bottom_padding": {
          "type": "panel",
          "size": [ "100%", 4 ]
        }
      }
    ]
  },

  "long_form_dynamic_buttons_panel": {
    "type": "grid",
    "size": ["100%", "100%c"],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",

    "grid_rescaling_type": "horizontal",
    "grid_item_template": "morph_menu.dynamic_button",

    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_length",
        "binding_name_override": "#maximum_grid_items"
      }
    ]
  },

  "player_scrolling_content": {
    "type": "stack_panel",
    "size": [ "100%", "100%c" ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "top_padding": {
          "type": "panel",
          "size": [ "100%", 4 ]
        }
      },
      {
        "wrapping_panel": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [
            {
              "player_dynamic_buttons_panel@morph_menu.player_dynamic_buttons_panel": {}
            }
          ]
        }
      },
      {
        "bottom_padding": {
          "type": "panel",
          "size": [ "100%", 4 ]
        }
      }
    ]
  },

  "player_dynamic_buttons_panel": {
    "type": "grid",
    "size": [ "100%", "100%c" ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "grid_rescaling_type": "horizontal",
    "grid_item_template": "morph_menu.player_dynamic_button",
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_length",
        "binding_name_override": "#maximum_grid_items"
      }
    ]
  },

  "player_dynamic_button": {
    "type": "panel",
    "size": [ 56, 56 ],
    "clips_children": true,
    "controls": [
      {
        "image": {
          "type": "image",
          "layer": 2,
          "size": [ 32, 32 ],
          "offset": [ 0, -5 ],
          "bindings": [
            {
              "binding_name": "#form_button_texture",
              "binding_name_override": "#texture",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_name": "#form_button_texture_file_system",
              "binding_name_override": "#texture_file_system",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      },
      {
        "player_name": {
          "type": "label",
          "size": [ "100% - 6px", 10 ],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [ 0, -2 ],
          "layer": 5,
          "color": [ 1, 1, 1 ],
          "text": "#player_name_text",
          "text_alignment": "center",
          "font_scale_factor": 0.8,
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_name_override": "#player_name_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (#player_name_text = ''))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "form_button@common.button": {
          "$pressed_button_name": "button.form_button_click",
          "size": [ 56, 56 ],
          "controls": [
            {
              "hover@common.focus_border_white": {}
            },
            {
              "pressed@common.focus_border_white": {}
            }
          ],
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  "dynamic_button": {
    "type": "panel",
    "size": [ 48, 48 ],
    "$player_model_texture": "__player_paper_doll__",
    "controls": [
      {
        "panel_name": {
          "type": "panel",
          "size": [ "100%c", "100%c" ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "image",
              "resolve_sibling_scope": true,
              "source_property_name": "(not (#texture = ''))",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "image": {
                "type": "image",
                "layer": 2,
                "size": [ 32, 32 ],
                "offset": [ 0, 0 ],
                "bindings": [
                  {
                    "binding_name": "#form_button_texture",
                    "binding_name_override": "#texture",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_name": "#form_button_texture_file_system",
                    "binding_name_override": "#texture_file_system",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(not ((#texture = '') or (#texture = 'loading') or (#texture = $player_model_texture)))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "progress@progress.progress_loading_bars": {
                "size": [ 32, 4 ],
                "offset": [ 0, 0 ],
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "image",
                    "resolve_sibling_scope": true,
                    "source_property_name": "(#texture = 'loading')",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ]
        }
      },
{
        "player_model": {
          "type": "custom",
          "renderer": "paper_doll_renderer",
          "camera_tilt_degrees": -30,
          "layer": 2,
          "anchor_from": "center",
          "anchor_to": "center",
          "rotation": "custom_y",
          "property_bag": {
            "#custom_rot_y": 45.0
          },
          "size": [ "85%", "85%" ],
          "offset": [ 0, -6 ],
          "animation_reset_name": "screen_animation_reset",
          "anims": [
            "@common.screen_exit_size_animation_push",
            "@common.screen_exit_size_animation_pop",
            "@common.screen_entrance_size_animation_push",
            "@common.screen_entrance_size_animation_pop"
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "image",
              "resolve_sibling_scope": true,
              "source_property_name": "(#texture = $player_model_texture)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "badge": {
          "type": "label",
          "size": [ 26, 14 ],
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [ -3, -1 ],
          "layer": 5,
          "color": [ 1, 1, 1 ],
          "text": "#badge_text",
          "text_alignment": "right",
          "font_scale_factor": 1.2,
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_name_override": "#badge_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (#badge_text = ''))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "form_button@common.button": {
          "$pressed_button_name": "button.form_button_click",
          "size": [ 48, 48 ],
          "controls": [
            {
              "hover@common.focus_border_white": {}
            },
            {
              "pressed@common.focus_border_white": {}
            }
          ],
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  "menu_background@common.dialog_background_hollow_common": {
    "texture": "textures/ui/morph_menu_background"
  },

  "player_renderer_background@common.dialog_background_hollow_common": {
    "texture": "textures/ui/player_renderer_morph_menu_background"
  }
}
