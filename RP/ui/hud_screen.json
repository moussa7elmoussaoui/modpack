{
	"hud_actionbar_text": {
		"type": "image",
		"size": ["100%c + 12px", "100%c + 5px"],
		"anchor_from": "bottom_middle",
		"anchor_to": "bottom_left",
		"offset": [105, -4],
		"texture": "textures/ui/hud_tip_text_background",
		"alpha": "@hud.anim_actionbar_text_background_alpha_out",
		"$atext": "$actionbar_text",
		"visible": "(not (($atext = '') or ($atext = '§r') or ($atext = '§0§k§r') or ($atext = '§1§k§r') or ($atext = '§2§k§r') or ($atext = '§3§k§r')))",
		"controls": [
			{
				"actionbar_message": {
					"type": "label",
					"anchor_from": "center",
					"anchor_to": "center",
					"color": "$tool_tip_text",
					"layer": 1,
					"text": "$actionbar_text",
					"shadow": false,
					"localize": false,
					"alpha": "@hud.anim_actionbar_text_alpha_out"
				}
			}
		]
	},

	"fireblast_move_hud": {
		"type": "panel",
		"size": ["100%", "100%"],
		"controls": [
			{
				"flame_shot": {
					"type": "image",
					"anchor_from": "bottom_middle",
					"anchor_to": "bottom_right",
					"size": ["100%c + 18px", "100%c + 8px"],
					"offset": [-105, -4],
					"texture": "textures/ui/effect_background",
					"alpha": 0.7,
					"$atext": "$actionbar_text",
					"visible": "(not (($atext - '§0§k§r') = $atext))",
					"controls": [
						{
							"move_name": {
								"type": "label",
								"anchor_from": "center",
								"anchor_to": "center",
								"color": "$tool_tip_text",
								"layer": 1,
								"text": "§6Flame Shot",
								"shadow": false,
								"localize": false,
								"alpha": 1
							}
						}
					]
				}
			},
			{
				"scorpion_sting": {
					"type": "image",
					"anchor_from": "bottom_middle",
					"anchor_to": "bottom_right",
					"size": ["100%c + 18px", "100%c + 8px"],
					"offset": [-105, -4],
					"texture": "textures/ui/effect_background",
					"alpha": 0.7,
					"$atext": "$actionbar_text",
					"visible": "(not (($atext - '§1§k§r') = $atext))",
					"controls": [
						{
							"move_name": {
								"type": "label",
								"anchor_from": "center",
								"anchor_to": "center",
								"color": "$tool_tip_text",
								"layer": 1,
								"text": "§6Scorpion Sting",
								"shadow": false,
								"localize": false,
								"alpha": 1
							}
						}
					]
				}
			},
			{
				"dragon_strike": {
					"type": "image",
					"anchor_from": "bottom_middle",
					"anchor_to": "bottom_right",
					"size": ["100%c + 18px", "100%c + 8px"],
					"offset": [-105, -4],
					"texture": "textures/ui/effect_background",
					"alpha": 0.7,
					"$atext": "$actionbar_text",
					"visible": "(not (($atext - '§2§k§r') = $atext))",
					"controls": [
						{
							"move_name": {
								"type": "label",
								"anchor_from": "center",
								"anchor_to": "center",
								"color": "$tool_tip_text",
								"layer": 1,
								"text": "§6Dragon Strike",
								"shadow": false,
								"localize": false,
								"alpha": 1
							}
						}
					]
				}
			},
			{
				"bounce_blast": {
					"type": "image",
					"anchor_from": "bottom_middle",
					"anchor_to": "bottom_right",
					"size": ["100%c + 18px", "100%c + 8px"],
					"offset": [-105, -4],
					"texture": "textures/ui/effect_background",
					"alpha": 0.7,
					"$atext": "$actionbar_text",
					"visible": "(not (($atext - '§3§k§r') = $atext))",
					"controls": [
						{
							"move_name": {
								"type": "label",
								"anchor_from": "center",
								"anchor_to": "center",
								"color": "$tool_tip_text",
								"layer": 1,
								"text": "§6Bounce Blast",
								"shadow": false,
								"localize": false,
								"alpha": 1
							}
						}
					]
				}
			}
		]
	},

	"hud_title_text": {
		"modifications": [
			{
				"array_name": "bindings",
				"operation": "insert_front",
				"value": [
					{
						"binding_type": "global",
						"binding_name": "#hud_title_text_string",
						"binding_name_override": "#text"
					}
				]
			},
			{
				"array_name": "bindings",
				"operation": "insert_back",
				"value": [
					{
						"binding_type": "view",
						"source_property_name": "(not ('%.6s' * #text = '_r4ui:'))",
						"target_property_name": "#visible"
					}
				]
			}
		]
	},

	"root_panel": {
		"size": ["100%", "100%"],

		"modifications": [
			{
				"array_name": "controls",
				"operation": "insert_front",
				"value": [
					{
						"fireblast_move_hud_factory": {
							"type": "panel",
							"factory": {
								"name": "hud_actionbar_text_factory",
								"control_ids": {
									"hud_actionbar_text": "@hud.fireblast_move_hud"
								}
							}
						}
					},
					{
						"waila@common.empty_panel": {
							"$anchor": "center",
							"anchor_from": "$anchor",
							"anchor_to": "$anchor",

							"size": ["100%", "100%"],
							"offset": [0, 0],

							"factory": {
								"name": "hud_title_text_factory",
								"control_ids": {
									"hud_title_text": "disp@r4isen1920_waila_main.centerer"
								}
							}
						}
					}
				]
			}
		]
	}
}
