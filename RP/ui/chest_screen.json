{
  "namespace": "chest",
  "chest_label": {
    "text": "",
    "size": [
      "100%c",
      "100%c"
    ],
    "$new_custom_name|default": "$container_title",
    "$is_invsee_title|default": false,
    "$invsee_title_prefix|default": "",
    "$invsee_title_suffix|default": "",
    "controls": [
      {
        "stack": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [
            "100%c",
            "100%cm"
          ],
          "controls": [
            {
              "base_label@dark7mc_invsee_inventory.label": {
                "text": "$new_custom_name",
                "ignored": "$is_invsee_title"
              }
            },
            {
              "localized_title@dark7mc_invsee_inventory.localized_title": {
                "ignored": "(not $is_invsee_title)"
              }
            }
          ]
        }
      }
    ]
  },
  "large_chest_panel_top_half": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "inventory_viewer_grid@dark7mc_invsee_inventory.inventory_viewer_grid": {
              "offset": [
                0,
                -2.5
              ],
              "ignored": "(not $use_custom_screen)"
            }
          }
        ]
      }
    ]
  },
  "large_chest_panel_top_half/large_chest_grid": {
    "ignored": "$use_custom_screen"
  },
  "small_chest_screen": {
    "$container_name": "$container_title",
    "$use_custom_screen|default": false,
    "modifications": [
      {
        "array_name": "variables",
        "operation": "insert_back",
        "value": [
          {
            "requires": "(('%.16s' * $container_name) = '_dark7mc:invsee:')",
            "$screen_content": "chest.large_chest_panel",
            "$screen_bg_content": "common.screen_background",
            "$new_custom_name": "($container_name - ('%.22s' * $container_name))",
            "$is_invsee_title": true,
            "$invsee_title_prefix": "invsee.inventory.title_prefix",
            "$invsee_title_suffix": "invsee.inventory.title_suffix",
            "$use_custom_screen": true
          },
          {
            "requires": "(('%.20s' * $container_name) = '_dark7mc:enderchest:')",
            "$new_custom_name": "($container_name - ('%.20s' * $container_name))",
            "$is_invsee_title": true,
            "$invsee_title_prefix": "invsee.enderchest.title_prefix",
            "$invsee_title_suffix": "invsee.enderchest.title_suffix"
          }
        ]
      }
    ]
  },
  "large_chest_screen": {
    "$container_name": "$container_title",
    "$use_custom_screen": false
  },
  "ender_chest_screen": {
    "$container_name": "$container_title",
    "$use_custom_screen": false
  },
  "shulker_box_screen": {
    "$container_name": "$container_title",
    "$use_custom_screen": false
  },
  "barrel_screen": {
    "$container_name": "$container_title",
    "$use_custom_screen": false
  }
}
