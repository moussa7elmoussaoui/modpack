{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "dark7mc:night_fury_wake_rain_splash_emitter",
      "basic_render_parameters": {
        "material": "particles_opaque",
        "texture": "textures/night_fury_wake/spray_particles"
      }
    },
    "events": {
      "rain_splash_expiration": {
        "sequence": [
          {
            "expression": "t.particle_alive = v.particle_age < v.particle_lifetime;"
          },
          {
            "particle_effect": {
              "effect": "dark7mc:night_fury_wake_rain_drop_splash",
              "type": "emitter",
              "pre_effect_expression": "v.particle_count = t.particle_alive;"
            }
          }
        ]
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 2
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -5,
          0
        ]
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0,
        "expire_on_contact": true
      },
      "minecraft:particle_expire_if_in_blocks": [
        "minecraft:water",
        "minecraft:flowing_water"
      ],
      "minecraft:particle_lifetime_events": {
        "expiration_event": "rain_splash_expiration"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0,
          0
        ]
      }
    }
  }
}
