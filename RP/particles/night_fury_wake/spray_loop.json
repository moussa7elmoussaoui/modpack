{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "dark7mc:night_fury_wake_spray_loop",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/night_fury_wake/spray_particles"
      }
    },
    "events": {
      "wake_foam_expiration": {
        "particle_effect": {
          "effect": "dark7mc:night_fury_wake_rain_splash_particle",
          "type": "particle"
        }
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 30,
        "max_particles": 100
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          "(v.particle_random_1-0.5)*1.5*variable.night_fury_wake_right.x-0.75*variable.night_fury_wake_forward.x",
          "-0.9",
          "(v.particle_random_1-0.5)*1.5*variable.night_fury_wake_right.z-0.75*variable.night_fury_wake_forward.z"
        ],
        "direction": [
          "(v.particle_random_1-0.5)*2*variable.night_fury_wake_right.x-1.5*variable.night_fury_wake_forward.x",
          1,
          "(v.particle_random_1-0.5)*2*variable.night_fury_wake_right.z-1.5*variable.night_fury_wake_forward.z"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 2
      },
      "minecraft:particle_expire_if_not_in_blocks": [
        "minecraft:air"
      ],
      "minecraft:particle_lifetime_events": {
        "expiration_event": "wake_foam_expiration"
      },
      "minecraft:particle_initial_speed": "Math.random(5,10)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "-Math.random(20,25)",
          0
        ],
        "linear_drag_coefficient": "Math.random(2,3)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "1/16/2",
          "1/16/2"
        ],
        "facing_camera_mode": "rotate_xyz"
      },
      "minecraft:particle_motion_collision": {
        "collision_drag": 30,
        "collision_radius": 0.0625
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(255/255)+((111/255)-(255/255))*(1-Math.hermite_blend(Math.clamp((variable.night_fury_wake_time_of_day-0.2)/0.05,0,1))+Math.hermite_blend(Math.clamp((variable.night_fury_wake_time_of_day-0.76)/0.05,0,1)))",
          "(255/255)+((121/255)-(255/255))*(1-Math.hermite_blend(Math.clamp((variable.night_fury_wake_time_of_day-0.2)/0.05,0,1))+Math.hermite_blend(Math.clamp((variable.night_fury_wake_time_of_day-0.76)/0.05,0,1)))",
          "(255/255)+((165/255)-(255/255))*(1-Math.hermite_blend(Math.clamp((variable.night_fury_wake_time_of_day-0.2)/0.05,0,1))+Math.hermite_blend(Math.clamp((variable.night_fury_wake_time_of_day-0.76)/0.05,0,1)))",
          1
        ]
      }
    }
  }
}
