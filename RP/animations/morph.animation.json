					"rotation" : [ 0.0, "query.target_y_rotation", 0.0 ]
				}
			}
		},
		"animation.morph.show_items" : {
			"loop" : true,
			"bones" : {
				"leftitem" : {
					"scale" : "variable.show_items"
				},
				"rightitem" : {
					"scale" : "variable.show_items"
				}
			}
		},
		"animation.morph.vertical_gliding" : {
			"loop" : true,
			"bones" : {
				"root" : {
					"rotation" : [ -90.0, 0.0, 0.0 ]
				}
			}
		}
	}
