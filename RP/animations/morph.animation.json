{
	"format_version" : "1.8.0",
	"animations" : {
		"animation.morph.look_at_target_y" : {
			"loop" : true,
			"bones" : {
				"root" : {
					"rotation" : [ 0.0, "query.target_y_rotation", 0.0 ]
				}
			}
		},
		"animation.morph.show_items" : {
			"loop" : true,
			"bones" : {
				"leftitem" : {
					"scale" : "variable.show_items"
				},
				"rightitem" : {
					"scale" : "variable.show_items"
				}
			}
		},
		"animation.morph.vertical_gliding" : {
			"loop" : true,
			"bones" : {
				"root" : {
					"rotation" : [ -90.0, 0.0, 0.0 ]
				}
			}
		},
		"animation.morph.sleeping" : {
			"loop": true,
			"bones": {
				"head": {
					"position": [
						0,
						0,
						"variable.sleep_head_offset"
					],
					"rotation": [
						"variable.sleep_head_rotation",
						0,
						0
					]
				},
				"_head": {
					"position": [
						0,
						0,
						"variable.sleep_head_offset"
					],
					"rotation": [
						"variable.sleep_head_rotation",
						0,
						0
					]
				},
				"root": {
					"position": [
						"variable.sleep_position.h * math.cos(query.body_y_rotation) * math.cos(query.sleep_rotation) - variable.sleep_position.h * math.sin(query.body_y_rotation) * math.sin(query.sleep_rotation)",
						"variable.sleep_position.v",
						"variable.sleep_position.h * math.cos(query.body_y_rotation) * math.sin(query.sleep_rotation) + variable.sleep_position.h * math.sin(query.body_y_rotation) * math.cos(query.sleep_rotation)"
					],
					"rotation": [
						"variable.sleep_rotation.x",
						"variable.sleep_rotation.y - query.sleep_rotation - query.body_y_rotation",
						0
					]
				}
			}
		}
	}
}
