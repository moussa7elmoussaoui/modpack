					"rotation" : [ "variable.polar_bear_standing_scale * 63", 0.0, 0.0 ]
				},
				"leg1" : {
					"position" : [ 0.0, "-1 * variable.polar_bear_standing_scale", "6 * variable.polar_bear_standing_scale" ],
					"rotation" : [ "variable.polar_bear_standing_scale * 63", 0.0, 0.0 ]
				},
				"leg2" : {
					"rotation" : [ "(variable.polar_bear_standing_scale >= 1) ? (variable.polar_bear_standing_scale * 81) - this : 0", 0.0, 0.0 ]
				},
				"leg3" : {
					"rotation" : [ "(variable.polar_bear_standing_scale >= 1) ? (variable.polar_bear_standing_scale * 81) - this : 0", 0.0, 0.0 ]
				}
			}
