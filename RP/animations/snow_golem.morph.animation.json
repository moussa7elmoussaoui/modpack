{
	"format_version" : "1.8.0",
	"animations" : {
		"animation.morph.snow_golem.crawling" : {
			"loop" : true,
			"bones" : {
				"root" : {
					"position" : [ 0.0, "5.0 * variable.swim_amount", "16.0 * variable.swim_amount" ],
					"rotation" : [ "variable.swim_amount * 90", 0.0, 0.0 ]
				}
			}
		},
		"animation.morph.snow_golem.move" : {
			"loop" : true,
			"bones" : {
				"piece1" : {
					"rotation" : [ 0.0, "query.target_y_rotation * 0.25", 0.0 ]
				}
			}
		},
		"animation.morph.snow_golem.sleeping" : {
			"loop" : true,
			"bones" : {
				"root" : {
					"position" : [ "22.0 * math.cos(query.body_y_rotation) * math.cos(query.sleep_rotation) - 22.0 * math.sin(query.body_y_rotation) * math.sin(query.sleep_rotation)", 1.5, "22.0 * math.cos(query.body_y_rotation) * math.sin(query.sleep_rotation) + 22.0 * math.sin(query.body_y_rotation) * math.cos(query.sleep_rotation)" ],
					"rotation" : [ -90.0, "270.0 - query.sleep_rotation - query.body_y_rotation", 0.0 ]
				}
			}
		},
		"animation.morph.snow_golem.swimming" : {
			"loop" : true,
			"bones" : {
				"root" : {
					"position" : [ 0.0, "(math.sin(query.target_x_rotation) * 16.0 + 5.0) * variable.swim_amount", "(math.cos(query.target_x_rotation) * 16.0) * variable.swim_amount" ],
					"rotation" : [ "variable.swim_amount * (90 + query.target_x_rotation)", 0.0, 0.0 ]
				}
			}
		}
	}
}