{
	"format_version" : "1.8.0",
	"animations" : {
		"animation.morph.ravager.biting" : {
			"animation_length" : 0.75, // Value must be the same with the 'variable.ravager_bite_anim_duration'
			"bones" : {
				"mouth" : {
					"rotation" : [ "math.sin(math.min(query.anim_time / (variable.ravager_bite_anim_duration / 2.0f), 1.0f) * 180.0f) * 40.0f", 0.0, 0.0 ]
				},
				"neck" : {
					"position" : [ 0.0, 0.0, "-math.sin(math.min(query.anim_time / variable.ravager_bite_anim_duration, 1.0f) * 180.0f) * variable.ravager_bite_neck_length" ]
				}
			}
		},
		"animation.morph.ravager.idle_mouth" : {
			"loop" : true,
			"bones" : {
				"mouth" : {
					"rotation" : [ 1.8, 0.0, 0.0 ]
				},
				"neck" : {
					"position" : [ 0.0, 0.0, 0.0 ]
				}
			}
		},
		"animation.morph.ravager.walk" : {
			"loop" : true,
			"bones" : {
				"leg0" : {
					"rotation" : [ "math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed *  22.92", 0.0, 0.0 ]
				},
				"leg1" : {
					"rotation" : [ "math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed * -22.92", 0.0, 0.0 ]
				},
				"leg2" : {
					"rotation" : [ "math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed * -22.92", 0.0, 0.0 ]
				},
				"leg3" : {
					"rotation" : [ "math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed *  22.92", 0.0, 0.0 ]
				}
			}
		},
		"animation.morph.ravager.sleeping" : {
			"loop" : true,
			"bones" : {
				"_head" : {
					"position" : [ 0.0, 0.0, -13.0 ],
					"rotation" : [ "90.0 - this", "-this", "-this" ]
				},
				"root" : {
					"position" : [ "8.0 * math.cos(query.body_y_rotation) * math.cos(query.sleep_rotation) - 8.0 * math.sin(query.body_y_rotation) * math.sin(query.sleep_rotation)", 28.0, "8.0 * math.cos(query.body_y_rotation) * math.sin(query.sleep_rotation) + 8.0 * math.sin(query.body_y_rotation) * math.cos(query.sleep_rotation)" ],
					"rotation" : [ -180.0, "270.0 - query.sleep_rotation - query.body_y_rotation", 0.0 ]
				}
			}
		}
	}
