{
	"format_version" : "1.8.0",
	"animations" : {
		"animation.morph.horse.look_at_player" : {
			"loop" : true,
			"bones" : {
				"neck" : {
					"rotation" : [ "variable.horse_head_x_rot * (1.0 - variable.horse_stand_anim)", "math.clamp(query.target_y_rotation, -20, 20) * (1.0 - variable.horse_stand_anim)", 0.0 ]
				}
			}
		},
		"animation.morph.horse.rear" : {
			"loop" : true,
			"bones" : {
				"body" : {
					"rotation" : [ "-45.0 * variable.horse_stand_anim", 0.0, 0.0 ]
				},
				"legbl" : {
					"rotation" : [ "45.0 * variable.horse_stand_anim", 0.0, 0.0 ]
				},
				"legbr" : {
					"rotation" : [ "45.0 * variable.horse_stand_anim", 0.0, 0.0 ]
				},
				"legfl" : {
					"rotation" : [ "(-60.0 + math.cos((query.life_time * 20.0) * 34.38) * 57.3) * variable.horse_stand_anim", 0.0, 0.0 ]
				},
				"legfr" : {
					"rotation" : [ "(-60.0 - math.cos((query.life_time * 20.0) * 34.38) * 57.3) * variable.horse_stand_anim", 0.0, 0.0 ]
				},
				"neck" : {
					"rotation" : [ "(15.0 + variable.horse_head_x_rot) * variable.horse_stand_anim", 0.0, 0.0 ]
				},
				"tail" : {
					"rotation" : [ "55.0 * variable.horse_stand_anim", 0.0, 0.0 ]
				}
			}
		},
		"animation.morph.horse.sleeping" : {
			"loop" : true,
			"bones" : {
				"neck": {
					"rotation" : [ 60.0, 0.0, 0.0 ]
				},
				"root" : {
					"position" : [ "14.0 * math.cos(query.body_y_rotation) * math.cos(query.sleep_rotation) - 14.0 * math.sin(query.body_y_rotation) * math.sin(query.sleep_rotation)", 18.5, "14.0 * math.cos(query.body_y_rotation) * math.sin(query.sleep_rotation) + 14.0 * math.sin(query.body_y_rotation) * math.cos(query.sleep_rotation)" ],
					"rotation" : [ -180.0, "270.0 - query.sleep_rotation - query.body_y_rotation", 0.0 ]
				},
				"tail" : {
					"rotation" : [ 135.0, 0.0, 0.0 ]
				}
			}
		},
		"animation.morph.horse.walk" : {
			"loop" : true,
			"bones" : {
				"bagl" : {
					"rotation" : [ "variable.horse_leg_x_rot_anim / 5.0", 0.0, 0.0 ]
				},
				"bagr" : {
					"rotation" : [ "-variable.horse_leg_x_rot_anim / 5.0", 0.0, 0.0 ]
				},
				"legbl" : {
					"rotation" : [ "(-variable.horse_leg_stand_factor * 28.6 * query.modified_move_speed) * (1.0 - variable.horse_stand_anim)", 0.0, 0.0 ]
				},
				"legbr" : {
					"rotation" : [ "(variable.horse_leg_stand_factor * 28.6 * query.modified_move_speed) * (1.0 - variable.horse_stand_anim)", 0.0, 0.0 ]
				},
				"legfl" : {
					"rotation" : [ "variable.horse_leg_x_rot_anim * (1.0 - variable.horse_stand_anim)", 0.0, 0.0 ]
				},
				"legfr" : {
					"rotation" : [ "-variable.horse_leg_x_rot_anim * (1.0 - variable.horse_stand_anim)", 0.0, 0.0 ]
				}
			}
		}
	}
}