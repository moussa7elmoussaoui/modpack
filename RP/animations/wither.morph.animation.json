{
	"format_version" : "1.8.0",
	"animations" : {
		"animation.morph.wither.crawling" : {
			"loop" : true,
			"bones" : {
				"root" : {
					"position" : [ 0.0, "5.0 * variable.swim_amount", "21.0 * variable.swim_amount" ],
					"rotation" : [ "variable.swim_amount * 90", 0.0, 0.0 ]
				}
			}
		},
		"animation.morph.wither.look_at_target.default" : {
			"loop" : true,
			"bones" : {
				"head1" : {
					"rotation" : [ "query.target_x_rotation", "query.target_y_rotation", 0.0 ]
				},
				"head2" : {
					"rotation" : [ "query.target_x_rotation", "query.target_y_rotation", 0.0 ]
				},
				"head3" : {
					"rotation" : [ "query.target_x_rotation", "query.target_y_rotation", 0.0 ]
				}
			}
		},
		"animation.morph.wither.look_at_target.gliding" : {
			"loop" : true,
			"bones" : {
				"head1" : {
					"rotation" : [ -45.0, "query.target_y_rotation", 0.0 ]
				},
				"head2" : {
					"rotation" : [ -45.0, "query.target_y_rotation", 0.0 ]
				},
				"head3" : {
					"rotation" : [ -45.0, "query.target_y_rotation", 0.0 ]
				}
			}
		},
		"animation.morph.wither.look_at_target.swimming" : {
			"loop" : true,
			"bones" : {
				"head1" : {
					"rotation" : [ "math.lerp(query.target_x_rotation, -45.0, variable.swim_amount)", "query.target_y_rotation", 0.0 ]
				},
				"head2" : {
					"rotation" : [ "math.lerp(query.target_x_rotation, -45.0, variable.swim_amount)", "query.target_y_rotation", 0.0 ]
				},
				"head3" : {
					"rotation" : [ "math.lerp(query.target_x_rotation, -45.0, variable.swim_amount)", "query.target_y_rotation", 0.0 ]
				}
			}
		},
		"animation.morph.wither.move" : {
			"loop" : true,
			"bones" : {
				"upperbodypart2" : {
					"rotation" : [ "variable.wither_upper_body_rotation - this", "-this", "-this" ]
				},
				"upperbodypart3" : {
					"position" : [ -2.0, -16.9, -0.5 ],
					"rotation" : [ "((0.2 + 0.1 * variable.wither_body_base_rotation) * 180) - this", "-this", "-this" ]
				}
			}
		},
		"animation.morph.wither.scale" : {
			"loop" : true,
			"bones" : {
				"upperbodypart1" : {
					"rotation" : [ "-this", "-this", "-this" ]
				}
			}
		},
		"animation.morph.wither.sleeping" : {
			"loop" : true,
			"bones" : {
				"head1" : {
					"rotation" : [ "30.0 - this", "-this", "-this" ]
				},
				"head2" : {
					"rotation" : [ "30.0 - this", "-this", "-this" ]
				},
				"head3" : {
					"rotation" : [ "30.0 - this", "-this", "-this" ]
				},
				"root" : {
					"position" : [ "20.0 * math.cos(query.body_y_rotation) * math.cos(query.sleep_rotation) - 20.0 * math.sin(query.body_y_rotation) * math.sin(query.sleep_rotation)", 0.0, "20.0 * math.cos(query.body_y_rotation) * math.sin(query.sleep_rotation) + 20.0 * math.sin(query.body_y_rotation) * math.cos(query.sleep_rotation)" ],
					"rotation" : [ -90.0, "270.0 - query.sleep_rotation - query.body_y_rotation", 0.0 ]
				}
			}
		},
		"animation.morph.wither.swimming" : {
			"loop" : true,
			"bones" : {
				"root" : {
					"position" : [ 0.0, "(math.sin(query.target_x_rotation) * 21.0 + 5.0) * variable.swim_amount", "(math.cos(query.target_x_rotation) * 21.0) * variable.swim_amount" ],
					"rotation" : [ "variable.swim_amount * (90 + query.target_x_rotation)", 0.0, 0.0 ]
				}
			}
		}
	}
}