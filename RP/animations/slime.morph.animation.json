{
	"format_version" : "1.8.0",
	"animations" : {
		"animation.morph.slime.scale" : {
			"loop" : true,
			"bones" : {
				"root" : {
					"scale": [ "variable.slime_horizontal_scale_amount", "variable.slime_vertical_scale_amount", "variable.slime_horizontal_scale_amount" ]
				}
			}
		},
		"animation.morph.slime.sleeping" : {
			"loop" : true,
			"bones" : {
				"root" : {
					"position" : [ "((query.variant * 8.0) - 6.0) * math.cos(query.body_y_rotation) * math.cos(query.sleep_rotation) - ((query.variant * 8.0) - 6.0) * math.sin(query.body_y_rotation) * math.sin(query.sleep_rotation)", "(query.variant * 4.0) - 2.0", "((query.variant * 8.0) - 6.0) * math.cos(query.body_y_rotation) * math.sin(query.sleep_rotation) + ((query.variant * 8.0) - 6.0) * math.sin(query.body_y_rotation) * math.cos(query.sleep_rotation)" ],
					"rotation" : [ -90.0, "270.0 - query.sleep_rotation - query.body_y_rotation", 0.0 ]
				}
			}
		}
	}
}