{
    "format_version": "1.8.0",
    "animations": {
        "animation.player.cape": {
            "loop": true,
            "bones": {
                "cape": {
                    "position": [ 0.0, "variable.cape_y_offset + (variable.cape_y_offset == -4.0 ? 4.0 : 0.0)", 0.0 ],
                    "rotation": [ "math.lerp(0.0, -126.0, query.cape_flap_amount) - 6.0", 0.0, 0.0 ]
                }
            }
        },
        "animation.player.holding": {
            "loop": true,
            "bones": {
                "leftarm": {
                    "rotation": [ "variable.is_holding_left && !query.equipped_item_any_tag('slot.weapon.offhand', 'dark7mc:morphing_bracelets') ? (-this * 0.5 - 18.0) : 0.0", 0.0, 0.0 ]
                },
                "rightarm": {
                    "rotation": [ "variable.is_holding_right && !query.equipped_item_any_tag('slot.weapon.mainhand', 'dark7mc:morphing_bracelets') ? (-this * 0.5 - 18.0) : 0.0", 0.0, 0.0 ]
                }
            }
        }
    }
}