                    "rotation": ["math.lerp(0, math.cos(query.modified_distance_moved * 30) * 17.18874, variable.swim_amount) - this", 0.1, 0.1]
                },
                "left_leg": {
                    "rotation": ["math.lerp(0, math.cos(query.modified_distance_moved * 30 + 180) * 17.18874, variable.swim_amount) - this", -0.1, -0.1]
                }
            }
        }
	}
}