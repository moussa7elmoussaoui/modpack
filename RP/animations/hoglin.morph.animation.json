{
	"format_version" : "1.8.0",
	"animations" : {
		"animation.morph.hoglin.look_at_target" : {
			"loop" : true,
			"bones" : {
				"_head" : {
					"rotation" : [ 0, "query.target_y_rotation - this", 0 ]
				}
			}
		},
		"animation.morph.hoglin.walk" : {
			"loop" : true,
			"bones": {
				"left_ear": {
					"rotation" : [ 0.0, 0.0, "variable.hoglin_tcos_left_side * 0.5" ]
				},
				"right_ear": {
					"rotation" : [ 0.0, 0.0, "variable.hoglin_tcos_right_side * 0.5" ]
				},
				"leg_back_right" : {
					"rotation" : [ "variable.hoglin_tcos_right_side", 0.0, 0.0 ]
				},
				"leg_back_left" : {
					"rotation" : [ "variable.hoglin_tcos_left_side", 0.0, 0.0 ]
				},
				"leg_front_right" : {
					"rotation" : [ "-variable.hoglin_tcos_right_side", 0.0, 0.0 ]
				},
				"leg_front_left" : {
					"rotation" : [ "-variable.hoglin_tcos_left_side", 0.0, 0.0 ]
				}
			}
		},
		"animation.morph.hoglin.attack": {
			"loop": true,
			"bones": {
				"_head" : {
					"rotation" : [ "variable.hoglin_attack_head_rot", 0, 0 ]
				}
			}
		},
		"animation.morph.hoglin.sleeping" : {
			"loop" : true,
			"bones" : {
				"root" : {
					"position" : [ "4.0 * math.cos(query.body_y_rotation) * math.cos(query.sleep_rotation) - 4.0 * math.sin(query.body_y_rotation) * math.sin(query.sleep_rotation)", 23.0, "4.0 * math.cos(query.body_y_rotation) * math.sin(query.sleep_rotation) + 4.0 * math.sin(query.body_y_rotation) * math.cos(query.sleep_rotation)" ],
					"rotation" : [ -180.0, "270.0 - query.sleep_rotation - query.body_y_rotation", 0.0 ]
				}
			}
		}
	}
}