{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.morph.skeleton_horse": {
      "part_visibility": [
        { "Saddle": false },
        { "Bit*": false },
        { "Bridle": false },
        { "Reins*": false },
        { "Bag*": false },
        { "MuleEar*": false }
      ],
      "geometry": "query.is_baby ? Geometry.skeleton_horse_baby : Geometry.skeleton_horse",
      "materials": [{ "*": "Material.skeleton_horse" }],
      "textures": [
        "query.is_baby ? Texture.skeleton_horse_baby: Texture.skeleton_horse"
      ]
    }
  }
}