{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.morph.axolotl": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.axolotl_lucy",
            "Texture.axolotl_cyan",
            "Texture.axolotl_gold",
            "Texture.axolotl_wild",
            "Texture.axolotl_blue"
          ],
          "Array.baby_skins": [
            "Texture.axolotl_baby_lucy",
            "Texture.axolotl_baby_cyan",
            "Texture.axolotl_baby_gold",
            "Texture.axolotl_baby_wild",
            "Texture.axolotl_baby_blue"
          ]
        }
      },
      "geometry": "query.is_baby ? Geometry.axolotl_baby : Geometry.axolotl",
      "materials": [
        { "*": "Material.axolotl" },
        { "*arm": "Material.axolotl_limbs" },
        { "*leg": "Material.axolotl_limbs" }
      ],
      "textures": [
        "query.is_baby ? Array.baby_skins[query.variant] : Array.skins[query.variant]"
      ]
    }
  }
}