{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.morph.cow": {
      "arrays": {
        "textures": {
            "Array.textures": [
                "Texture.cow_temperate",
                "Texture.cow_warm",
                "Texture.cow_cold"
            ],
            "Array.baby_textures": [
                "Texture.cow_baby_temperate",
                "Texture.cow_baby_warm",
                "Texture.cow_baby_cold"
            ]
        },
        "geometries": {
          "Array.geos": [
            "Geometry.cow_temperate",
            "Geometry.cow_warm",
            "Geometry.cow_cold"
          ]
        }
      },
      "geometry": "query.is_baby ? Geometry.cow_baby : Array.geos[variable.animal_climate_index]",
      "materials": [ { "*": "variable.animal_climate_index == 2 ? Material.cow_cold : Material.cow" } ],
      "textures": [ "query.is_baby ? Array.baby_textures[variable.animal_climate_index] : Array.textures[variable.animal_climate_index]" ]
    }
  }
}