{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.morph.camel": {
      "geometry": "query.is_baby ? Geometry.camel_baby : Geometry.camel",
      "materials": [{ "*": "Material.camel" }],
      "textures": ["query.is_baby ? Texture.camel_baby : Texture.camel"],
      "part_visibility": [
        { "saddle": "query.is_saddled" },
        { "bridle": "query.is_saddled" },
        { "reins*": "query.is_saddled && query.has_rider" }
      ]
    }
  }
}