{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.morph.villager_base": {
      "geometry": "query.is_baby ? Geometry.villager_baby : Geometry.villager",
      "materials": [
        { "*": "Material.villager" }
      ],
      "textures": [
        "query.is_baby ? Texture.villager_baby : Texture.villager"
      ]
    },
    "controller.render.morph.villager_biome": {
      "arrays": {
        "textures": {
          "Array.biomes": [ 
            "Texture.villager_plains",
            "Texture.villager_desert",
            "Texture.villager_jungle",
            "Texture.villager_savanna",
            "Texture.villager_snow",
            "Texture.villager_swamp",
            "Texture.villager_taiga"
          ],
          "Array.baby_biomes": [
            "Texture.villager_baby_plains",
            "Texture.villager_baby_desert",
            "Texture.villager_baby_jungle",
            "Texture.villager_baby_savanna",
            "Texture.villager_baby_snow",
            "Texture.villager_baby_swamp",
            "Texture.villager_baby_taiga"
          ]
        }
      },
      "geometry": "query.is_baby ? Geometry.villager_baby : Geometry.villager",
      "materials": [
        { "*": "Material.villager" }
      ],
      "textures": [
        "query.is_baby ? Array.baby_biomes[query.mark_variant] : Array.biomes[query.mark_variant]"
      ]
    }
  }
}