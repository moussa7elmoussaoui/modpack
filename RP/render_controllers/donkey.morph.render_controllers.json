{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.morph.donkey": {
      "part_visibility": [
        { "Saddle": "query.is_saddled" },
        { "Bit*": "query.is_saddled" },
        { "Bridle": "query.is_saddled" },
        { "Reins*": "query.is_saddled && query.has_rider" },
        { "Bag*": "query.is_chested" },
        { "Ear*": false }
      ],
      "geometry": "query.is_baby ? Geometry.donkey_baby : Geometry.donkey",
      "materials": [{ "*": "Material.donkey" }],
      "textures": [
        "query.is_baby ? Texture.donkey_baby: Texture.donkey"
      ]
    }
  }
}